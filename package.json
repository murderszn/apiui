{
  "name": "apiui",
  "version": "1.0.0",
  "description": "Turn your data into APIs instantly",
  "main": "index.js",
  "scripts": {
    "dev": "bash start-local.sh",
    "start": "npm run frontend-server",
    "start:local": "bash start-local.sh",
    "backend": "python3 backend/main.py",
    "frontend-server": "node server.js",
    "test:agent": "node --test agent/*.test.js",
    "eval:agent": "node agent/evaluate.js",
    "build": "echo 'Static files ready for deployment'",
    "vercel-deploy": "vercel --prod"
  },
  "keywords": [
    "api",
    "data",
    "fastapi",
    "csv",
    "json"
  ],
  "author": "apiui",
  "license": "MIT",
  "dependencies": {
    "socket.io-client": "^4.7.5",
    "socket.io": "^4.7.5",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "axios": "^1.6.8",
    "openai": "^4.52.7",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "nodemon": "^3.1.4"
  }
}
