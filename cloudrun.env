# Cloud Run Deployment Configuration
# Copy this file and update with your actual values

# Google Cloud Project Settings
PROJECT_ID=aurablox-ai
REGION=us-central1

# Service Configuration
SERVICE_NAME=apiui-backend
IMAGE_NAME=gcr.io/${PROJECT_ID}/${SERVICE_NAME}
IMAGE_TAG=latest

# Environment Variables for the application
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_AI_API_KEY=
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/apiui
DATABASE_NAME=apiui
SECRET_KEY=change-me-in-production
USE_GCS_STORAGE=True
GCS_BUCKET_NAME=apiui-files-${PROJECT_ID}
GCS_PROJECT_ID=${PROJECT_ID}
API_GATEWAY_URL=

# Optional: Custom Domain
# CUSTOM_DOMAIN=api.yourdomain.com

# Deployment Settings
MEMORY=1Gi
CPU=1
MAX_INSTANCES=10
CONCURRENCY=80
TIMEOUT=300
