        }


const authProviderRoutes = {
    github: '/auth/github/login',
    google: '/auth/google/login',
};

const signinButtonLabel = document.getElementById('signin-button-label');
const mobileSigninLabel = document.getElementById('mobile-signin-label');
const signinProviderOptions = document.getElementById('signin-provider-options');
const signedinDropdown = document.getElementById('signedin-dropdown');
const signedinName = document.getElementById('signedin-name');
const signedinEmail = document.getElementById('signedin-email');
const signedinAvatar = document.getElementById('signedin-avatar');
const signedinProfileLink = document.getElementById('signedin-profile-link');
const mobileSignedoutOptions = document.getElementById('mobile-signedout-options');
const mobileSignedinOptions = document.getElementById('mobile-signedin-options');
const mobileSignedinName = document.getElementById('mobile-signedin-name');
const mobileSignedinEmail = document.getElementById('mobile-signedin-email');
const mobileSignedinAvatar = document.getElementById('mobile-signedin-avatar');
const mobileSignedinProfileLink = document.getElementById('mobile-signedin-profile-link');
const logoutButtons = document.querySelectorAll('[data-auth-action="logout"]');
const authButtons = document.querySelectorAll('[data-auth-provider]');

const getAuthBaseUrl = () => {
    if (typeof window.apiuiGetBackendUrl === 'function') {
        try {
            const derived = window.apiuiGetBackendUrl();
            if (derived) {
                return derived;
            }
        } catch (error) {
            // Ignore helper resolution errors
        }
    }

    if (window.APIUI_AUTH_BASE_URL) {
        return window.APIUI_AUTH_BASE_URL;
    }

    const attr = document.body?.dataset?.authBase;
    if (attr) {
        return attr;
    }

    try {
        const stored = window.localStorage ? window.localStorage.getItem('apiui_backend_base_url') : null;
        if (stored) {
            return stored;
        }
    } catch (error) {
        // Ignore storage access issues
    }

    return '';
};

const buildAuthUrl = (path) => {
    if (!path) {
        return '';
    }

    const isAbsolute = /^https?:\/\//i.test(path);
    if (isAbsolute) {
        return path;
    }

    const normalizedPath = path.startsWith('/') ? path : `/${path}`;
    const base = getAuthBaseUrl();

    if (!base) {
        return normalizedPath;
    }

    const trimmedBase = base.replace(/\/+$/, '');
    return `${trimmedBase}${normalizedPath}`;
};

const resolveNextTarget = (button) => {
    if (button?.dataset?.authNext) {
        return button.dataset.authNext;
    }

    try {
        const currentUrl = new URL(window.location.href);
        if (currentUrl.protocol !== 'file:') {
            return currentUrl.href;
        }
    } catch (error) {
        // Fallback to origin or base url
    }

    if (window.location.origin && window.location.origin !== 'null') {
        return window.location.href || window.location.origin;
    }

    if (window.APIUI_APP_BASE_URL) {
        return window.APIUI_APP_BASE_URL;
    }

    return '/';
};

const buildAuthRequestUrl = (route, nextTarget) => {
    const baseUrl = buildAuthUrl(route);
    const url = /^https?:\/\//i.test(baseUrl) ? new URL(baseUrl) : new URL(baseUrl, window.location.href);
    url.searchParams.set('next', nextTarget);
    return url.toString();
};

authButtons.forEach(button => {
    button.addEventListener('click', (event) => {
        event.preventDefault();
        const provider = button.dataset.authProvider || 'github';
        const route = authProviderRoutes[provider] || authProviderRoutes.github;
        const nextTarget = resolveNextTarget(button);
        const loginUrl = buildAuthRequestUrl(route, nextTarget);
        window.location.href = loginUrl;
    });
});

const clearImage = (imgEl) => {
    if (!imgEl) {
        return;
    }
    imgEl.classList.add('hidden');
    imgEl.removeAttribute('src');
};

const setImage = (imgEl, src) => {
    if (!imgEl) {
        return;
    }
    if (src) {
        imgEl.src = src;
        imgEl.classList.remove('hidden');

        // Add error handling for Google avatars
        imgEl.onerror = function() {
            console.log('Avatar failed to load:', src);
            // Try to load a fallback avatar
            if (src && src.includes('googleusercontent.com')) {
                // Try different Google avatar sizes
                const fallbackSizes = ['s96-c', 's64-c', 's32-c'];
                for (const size of fallbackSizes) {
                    if (!src.includes(size)) {
                        const newSrc = src.replace(/=s\d+-c/, `=${size}`);
                        if (newSrc !== src) {
                            console.log('Trying fallback avatar:', newSrc);
                            imgEl.src = newSrc;
                            return;
                        }
                    }
                }
            }
            // If all fallbacks fail, hide the image
            clearImage(imgEl);
        };
    } else {
        clearImage(imgEl);
    }
};

const setProfileLink = (linkEl, url, label) => {
    if (!linkEl) {
        return;
    }

    if (url) {
        linkEl.href = url;
        const span = linkEl.querySelector('span');
        if (span && label) {
            span.textContent = label;
        }
        linkEl.classList.remove('hidden');
    } else {
        linkEl.classList.add('hidden');
        linkEl.removeAttribute('href');
    }
};

const applySignedOutUI = () => {
    if (signinButtonLabel) {
        signinButtonLabel.textContent = 'Sign In';
    }
    if (mobileSigninLabel) {
        mobileSigninLabel.textContent = 'Sign In';
    }
    if (signinProviderOptions) {
        signinProviderOptions.classList.remove('hidden');
    }
    if (signedinDropdown) {
        signedinDropdown.classList.add('hidden');
    }
    if (mobileSignedoutOptions) {
        mobileSignedoutOptions.classList.remove('hidden');
    }
    if (mobileSignedinOptions) {
        mobileSignedinOptions.classList.add('hidden');
    }
    if (signedinName) {
        signedinName.textContent = '';
    }
    if (signedinEmail) {
        signedinEmail.textContent = '';
        signedinEmail.classList.remove('hidden');
    }
    if (mobileSignedinName) {
        mobileSignedinName.textContent = '';
    }
    if (mobileSignedinEmail) {
        mobileSignedinEmail.textContent = '';
        mobileSignedinEmail.classList.remove('hidden');
    }
    clearImage(signedinAvatar);
    clearImage(mobileSignedinAvatar);
    setProfileLink(signedinProfileLink, null);
    setProfileLink(mobileSignedinProfileLink, null);
};

const applySignedInUI = (session) => {
    if (!session || !session.user) {
        applySignedOutUI();
        return;
    }

    const user = session.user;
    const provider = session.provider || 'account';
    const displayName = user.name || user.login || (user.email ? user.email.split('@')[0] : '') || 'Account';
    const email = user.email || '';
    const avatar = user.avatar_url || user.picture || '';
    const profileUrl = user.profile_url || user.html_url || '';
    const providerLabel = provider === 'github' ? 'View on GitHub' : provider === 'google' ? 'Manage Google account' : 'View profile';

    if (signinButtonLabel) {
        signinButtonLabel.textContent = displayName;
    }
    if (mobileSigninLabel) {
        mobileSigninLabel.textContent = displayName;
    }
    if (signinProviderOptions) {
        signinProviderOptions.classList.add('hidden');
    }
    if (signedinDropdown) {
        signedinDropdown.classList.remove('hidden');
    }
    if (mobileSignedoutOptions) {
        mobileSignedoutOptions.classList.add('hidden');
    }
    if (mobileSignedinOptions) {
        mobileSignedinOptions.classList.remove('hidden');
    }
    if (signedinName) {
        signedinName.textContent = displayName;
    }
    if (signedinEmail) {
        signedinEmail.textContent = email;
        signedinEmail.classList.toggle('hidden', !email);
    }
    if (mobileSignedinName) {
        mobileSignedinName.textContent = displayName;
    }
    if (mobileSignedinEmail) {
        mobileSignedinEmail.textContent = email;
        mobileSignedinEmail.classList.toggle('hidden', !email);
    }

    setImage(signedinAvatar, avatar);
    setImage(mobileSignedinAvatar, avatar);
    setProfileLink(signedinProfileLink, profileUrl, providerLabel);
    setProfileLink(mobileSignedinProfileLink, profileUrl, providerLabel);
};

const fetchAuthSession = async () => {
    // Check Supabase auth first
    try {
        const { data: { session }, error } = await supabase.auth.getSession();
        if (session && !error) {
            // User is authenticated with Supabase
            const user = session.user;
            const userData = {
                authenticated: true,
                provider: 'supabase',
                user: {
                    id: user.id,
                    email: user.email,
                    name: user.user_metadata?.name || user.email?.split('@')[0] || 'User',
                    avatar_url: user.user_metadata?.avatar_url
                }
            };
            applySignedInUI(userData);
            return;
        }
    } catch (error) {
        // Supabase check failed, continue to backend check
    }

    // Fallback to backend session check
    const sessionUrl = 'http://localhost:8000/auth/session';
    try {
        const response = await fetch(sessionUrl, { credentials: 'include' });
        if (!response.ok) {
            applySignedOutUI();
            return;
        }
        const data = await response.json();
        applySignedInUI(data);
    } catch (error) {
        applySignedOutUI();
    }
};

logoutButtons.forEach(button => {
    button.addEventListener('click', async (event) => {
        event.preventDefault();

        // Try Supabase logout first
        try {
            const { error } = await supabase.auth.signOut();
            if (!error) {
                sessionStorage.removeItem('supabase_session');
            }
        } catch (e) {
            // Ignore Supabase logout errors
        }

        // Fallback to backend logout
        const logoutUrl = 'http://localhost:8000/auth/logout';
        try {
            await fetch(logoutUrl, { method: 'POST', credentials: 'include' });
        } catch (error) {
            // Ignore logout errors
        }
        applySignedOutUI();
    });
});

applySignedOutUI();
fetchAuthSession();

// Email authentication handlers
const emailSigninForm = document.getElementById('email-signin-form');
const emailSignupForm = document.getElementById('email-signup-form');
const showSignupBtn = document.getElementById('show-signup');
const showSigninBtn = document.getElementById('show-signin');
const signinForm = document.getElementById('signin-form');
const signupForm = document.getElementById('signup-form');
const authMessage = document.getElementById('auth-message');

// Form switching
if (showSignupBtn && signupForm && signinForm) {
    showSignupBtn.addEventListener('click', (e) => {
        e.preventDefault();
        signupForm.classList.remove('hidden');
        signinForm.classList.add('hidden');
    });
}

if (showSigninBtn && signinForm && signupForm) {
    showSigninBtn.addEventListener('click', (e) => {
        e.preventDefault();
        signinForm.classList.remove('hidden');
        signupForm.classList.add('hidden');
    });
}

// Email authentication handlers
if (emailSigninForm) {
    emailSigninForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('signin-email').value;
        const password = document.getElementById('signin-password').value;

        showAuthMessage('Signing in...', 'text-blue-600');

        try {
            const { data, error } = await supabase.auth.signInWithPassword({
                email: email,
                password: password
            });

            if (error) {
                showAuthMessage(error.message, 'text-red-600');
            } else {
                showAuthMessage('Signed in successfully!', 'text-green-600');
            }
        } catch (error) {
            showAuthMessage('An error occurred during sign in', 'text-red-600');
        }
    });
}

if (emailSignupForm) {
    emailSignupForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('signup-email').value;
        const password = document.getElementById('signup-password').value;

        showAuthMessage('Creating account...', 'text-blue-600');

        try {
            const { data, error } = await supabase.auth.signUp({
                email: email,
                password: password
            });

            if (error) {
                showAuthMessage(error.message, 'text-red-600');
            } else {
                showAuthMessage('Account created! Please check your email to verify.', 'text-green-600');
            }
        } catch (error) {
            showAuthMessage('An error occurred during sign up', 'text-red-600');
        }
    });
}

// Auth message function
function showAuthMessage(message, colorClass) {
    if (authMessage) {
        authMessage.textContent = message;
        authMessage.className = `mt-3 text-sm text-center ${colorClass}`;
        authMessage.classList.remove('hidden');
    }
}

// Listen for auth state changes
supabase.auth.onAuthStateChange(async (event, session) => {
    console.log('Supabase auth state changed:', event, session);
    if (event === 'SIGNED_IN' && session) {
        await fetchAuthSession();
    } else if (event === 'SIGNED_OUT') {
        applySignedOutUI();
    }
});

        const backToTopBtn = document.getElementById('back-to-top');

        if (backToTopBtn) {
            window.addEventListener('scroll', () => {
                if (window.scrollY > 600) {
                    backToTopBtn.classList.add('show');
                } else {
                    backToTopBtn.classList.remove('show');
                }
            });

            backToTopBtn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // Category filtering
        const categoryButtons = document.querySelectorAll('.category-badge');
        const apiCards = document.querySelectorAll('.api-card');
        const categorySections = document.querySelectorAll('.category-section');
        const searchInput = document.getElementById('api-search');
        const emptyState = document.getElementById('api-empty-state');
        const resetFiltersBtn = document.getElementById('reset-filters');

        function filterAPIs() {
            const selectedCategory = document.querySelector('.category-active')?.dataset.category || 'all';
            const searchTerm = searchInput.value.toLowerCase();

            apiCards.forEach(card => {
                const cardCategory = card.dataset.category;
                const cardText = card.textContent.toLowerCase();

                const categoryMatch = selectedCategory === 'all' || cardCategory === selectedCategory;
                const searchMatch = cardText.includes(searchTerm);

                if (categoryMatch && searchMatch) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });

            let visibleSectionCount = 0;

            categorySections.forEach(section => {
                const visibleCard = Array.from(section.querySelectorAll('.api-card')).some(card => card.style.display !== 'none');
                section.style.display = visibleCard ? 'block' : 'none';
                if (visibleCard) {
                    visibleSectionCount += 1;
                }
            });

            if (emptyState) {
                if (visibleSectionCount === 0) {
                    emptyState.classList.remove('hidden');
                } else {
                    emptyState.classList.add('hidden');
                }
            }
        }

        // Category button clicks
        categoryButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Remove active class from all buttons
                categoryButtons.forEach(btn => btn.classList.remove('category-active'));
                // Add active class to clicked button
                button.classList.add('category-active');
                filterAPIs();
            });
        });

        // Search functionality
        searchInput.addEventListener('input', filterAPIs);

        if (resetFiltersBtn) {
            resetFiltersBtn.addEventListener('click', () => {
                categoryButtons.forEach(btn => btn.classList.remove('category-active'));
                const allButton = document.querySelector('.category-badge[data-category="all"]');
                if (allButton) {
                    allButton.classList.add('category-active');
                }
                searchInput.value = '';
                filterAPIs();
            });
        }

        filterAPIs();

        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
</body>
