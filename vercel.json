{
  "version": 2,
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/api-hub",
      "destination": "/api-hub.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
